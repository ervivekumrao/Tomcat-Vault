<!--
Tomcat Vault - JNDI Connection Pool Resource Configuration Examples
Compatible with Apache Tomcat 7, 8, 8.5, 9, 10, 10.1, 11

Generate encrypted passwords using:
  java -jar tomcat-vault-2.0.0.jar -e
-->
<Context>
    <!-- Example 1: Tomcat DBCP2 Pool with Modern AES-256-GCM ENC(...) -->
    <Resource
            name="jdbc/OracleData"
            auth="Container"
            type="javax.sql.DataSource"
            driverClassName="oracle.jdbc.Driver"
            factory="umrao.tomcat.vault.VaultBasicDataSourceFactory"
            validationQuery="SELECT 1 from dual"
            maxIdle="2"
            maxWaitMillis="5000"
            username="ENC(XAYad7xottt2lalhO6vL/JKEC33F1FOc7ctXWflNECfFGcyxerzh8CtfD8E1keLwmmVGv03qAN/SNB/jKT8=)"
            password="ENC(axVXzR5w+rr8ICucjw/ZZzhila/psl0pwBez6wo+29k3+Hbi/+6kN/YFcaqhOoCxniLc)"
            url="jdbc:oracle:thin:@DB_HOST:1521:ORCL"
            maxTotal="20" />

